# PostgreSQL connection URL from your database provider
DATABASE_URL=postgresql://username:password@host:5432/database
# Set PGSSL=true only if your database provider requires SSL connections
PGSSL=false
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Optional AI writing helper. Keep this key on the server; never put it in public/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
